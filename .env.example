# Application
APP_NAME=EcommerceMVP API
APP_ENV=development
APP_VERSION=0.1.0
MOCK_MODE=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Persistence and files
DATABASE_URL=sqlite:///./data/runtime/ecommerce_mvp.db
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_UPLOAD_SIZE_MB=10

# DeepSeek text provider (leave the key empty in Mock mode)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen image-edit provider (leave the key empty in Mock mode)
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_IMAGE_MODEL=qwen-image-edit

# Provider behavior
PROVIDER_TIMEOUT_SECONDS=60
